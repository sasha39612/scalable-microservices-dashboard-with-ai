# Copy to .env on the server and fill in. Never commit the real file.
# Generate every secret with:  openssl rand -hex 32
# Use hex only: these values are embedded in connection URLs, so special characters break them.

POSTGRES_USER=dashboard_user
POSTGRES_DB=microservices_dashboard
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Internal service keys (min. 32 chars; production start fails on short or placeholder values)
WORKER_SERVICE_API_KEY=
AI_SERVICE_API_KEY=

OPENAI_API_KEY=

# Public origin the browser uses (no trailing slash)
CORS_ORIGIN=http://169.58.224.26

# Plain http only. Switch to true once you serve over https.
COOKIE_SECURE=false
# Creates tables on first boot. Set to false after the first successful start.
DB_SYNCHRONIZE=true
